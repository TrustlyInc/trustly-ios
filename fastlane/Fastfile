default_platform(:ios)

TAG_VERSION = ENV["TAG_VERSION"] # Git tag version

platform :ios do
  lane :publish do
    lint
    build_and_run_tests
    verify_example_integrations
  end

  # Unit tests - SDK
  desc "Build the SDK and run unit tests; produces sonar-reports/TestResults.xcresult for coverage"
  lane :build_and_run_tests do
    scan(
      workspace: "./TrustlySDK.xcworkspace",
      scheme: 'TrustlySDK',
      devices: ["iPhone 16"],
      clean: true,
      code_coverage: true,
      derived_data_path: "sonar-reports/",
      result_bundle: true,
      result_bundle_path: "sonar-reports/TestResults.xcresult"
    )
  end

  desc "Build SwiftUI example app for iOS Simulator (direct TrustlySDK integration)"
  lane :verify_swiftui_example do
    build_ios_app(
      workspace: "./TrustlySDK.xcworkspace",
      scheme: "ExampleAppSwiftUI",
      configuration: "Debug",
      sdk: "iphonesimulator",
      destination: "platform=iOS Simulator,name=iPhone 17",
      clean: true,
      skip_archive: true,
      skip_package_ipa: true,
      silent: true
    )
  end

  desc "Install pods and build UIKit example app for iOS Simulator (TrustlySDK via CocoaPods)"
  lane :verify_uikit_example_cocoapods do
    cocoapods(
      podfile: "./ExampleApp/ExampleAppUIKit/Podfile",
      clean_install: true,
      silent: true
    )

    build_ios_app(
      workspace: "./ExampleApp/ExampleAppUIKit/ExampleAppUIKit.xcworkspace",
      scheme: "ExampleAppUIKit",
      configuration: "Debug",
      sdk: "iphonesimulator",
      destination: "platform=iOS Simulator,name=iPhone 17",
      clean: true,
      skip_archive: true,
      skip_package_ipa: true,
      silent: true
    )
  end

  desc "Verify TrustlySDK integration in both example apps"
  lane :verify_example_integrations do
    verify_swiftui_example
    verify_uikit_example_cocoapods
  end

  desc "Apply swift linting"
  lane :lint do
    swiftlint(
      output_file: "sonar-reports/TrustlySDK-swiftlint.txt",
      ignore_exit_status: true
    )
  end

  desc "Generate coverage XML and run SonarQube analysis; replaces run-sonar-swift.sh"
  lane :sonar_analysis do
    xcresult_path = "sonar-reports/TestResults.xcresult"

    # Generate coverage XML from the .xcresult produced by build_and_run_tests
    sh("bash xccov-to-sonarqube-generic.sh #{xcresult_path} > sonar-reports/generic-coverage.xml")

    # Verify coverage report was produced
    UI.user_error!("Coverage report not found: sonar-reports/generic-coverage.xml") unless File.exist?("sonar-reports/generic-coverage.xml")
    UI.user_error!("Coverage report is empty: sonar-reports/generic-coverage.xml") if File.zero?("sonar-reports/generic-coverage.xml")

    # Run SonarQube analysis (sonar-project.properties provides base config)
    sonar(
      project_key: ENV["SONAR_PROJECT_KEY"],
      project_name: ENV["SONAR_PROJECT_NAME"],
      sonar_url: ENV["SONAR_HOST_URL"],
      sonar_token: ENV["SONAR_TOKEN"],
      sonar_runner_args: [
        "-Dsonar.pullrequest.key=#{ENV['PR_NUMBER']}",
        "-Dsonar.pullrequest.branch=#{ENV['BRANCH_ORIGIN']}",
        "-Dsonar.pullrequest.base=#{ENV['BASE_BRANCH']}",
        "-Dsonar.scm.revision=#{ENV['GIT_REVISION']}",
        "-Dsonar.coverageReportPaths=sonar-reports/generic-coverage.xml"
      ].join(" ")
    )
  end
end